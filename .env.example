# Copy to .env.local and fill in. Every variable the app reads is listed here.

# --- Database ---------------------------------------------------------------
# Trades use multi-document transactions, so MongoDB must run as a replica set.
# MongoDB Atlas (any tier, including the free M0) already is one.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stocklens
# Local alternative: a single-node replica set (see "Database Setup" in the README)
# MONGODB_URI=mongodb://localhost:27017/stocklens?replicaSet=rs0

# --- Authentication (Better Auth) -------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 32`. Also derives
# the demo account password and signs email unsubscribe links.
BETTER_AUTH_SECRET=
# The app's public URL: used for verification and unsubscribe links and for
# link-preview images.
BETTER_AUTH_URL=http://localhost:3000

# --- Market data (Finnhub, free tier is enough) ------------------------------
# Read on the server only; never exposed to the browser. (Older deployments
# that set NEXT_PUBLIC_FINNHUB_API_KEY instead still work.)
FINNHUB_API_KEY=

# --- AI portfolio analysis and personalised welcome emails (Google Gemini) ---
GEMINI_API_KEY=

# --- Email (Gmail SMTP via nodemailer) ---------------------------------------
# Use a Gmail app password, not the account password.
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# --- Background jobs (Inngest) ----------------------------------------------
# Not needed locally with `npx inngest-cli@latest dev`; required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
